    {
      "parameters": {
        "jsCode": "const icons = { price_drop: '\\u{1F4B0}', leaflet_ending: '\\u23F3', new_leaflet: '\\u{1F4C4}' };\nconst lines = $json.alerts.map(a => (icons[a.alert_type] || '-') + ' ' + a.retailer + ' - ' + a.product_name + ': ' + a.detail);\nconst text = 'Grocery digest (' + lines.length + ')\\n' + lines.join('\\n');\nreturn [{ json: { text } }];"

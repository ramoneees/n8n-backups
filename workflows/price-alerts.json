    {
      "parameters": {
        "command": "=sqlite3 -json \"{{ $env.GROCERY_DB }}\" \"SELECT * FROM v_active_alerts;\""
      },
      "id": "b3f0de1c-3acb-4a0e-8a8f-6d4ac4fa1631",
      "name": "Query Active Alerts",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        272,
        304
      ],
      "onError": "continueErrorOutput",
      "notes": "exitCode 0=success 1=sqlite error. Reads the v_active_alerts view - see README TODO for the expected schema, this workflow does not create it."
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nlet rows = result.alerts !== undefined ? result.alerts : [];\nif (result.exitCode === 0 && result.stdout) {\n  try { rows = JSON.parse(result.stdout) || []; } catch (e) { rows = []; }\n}\nconst priority = { price_drop: 0, leaflet_ending: 1, new_leaflet: 2 };\nconst sorted = rows\n  .filter(r => r && r.alert_type in priority)\n  .sort((a, b) => (priority[a.alert_type] ?? 9) - (priority[b.alert_type] ?? 9))\n  .slice(0, 20);\nreturn [{ json: { alerts: sorted, count: sorted.length } }];"
      },
      "id": "1e31f2e8-47ca-41ff-8a88-6a4e8e1b6521",
      "name": "Group And Prioritize Alerts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        528,
        304
      ],
      "notes": "Priority order: price drop > leaflet ending > new leaflet. Expects each row from v_active_alerts to carry alert_type, retailer, product_name, detail."
    },
    {
      "parameters": {
        "jsCode": "console.log('v_active_alerts query failed: ' + ($json.stderr || 'unknown error'));\nreturn [{ json: { alerts: [], count: 0 } }];"
      },
      "id": "4ae50999-718d-423e-ba8f-f84b9b478a67",
      "name": "Log Query Failure",

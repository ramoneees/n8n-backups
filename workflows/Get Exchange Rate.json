        ],
        "parameters": {
          "method": "GET",
          "url": "https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=eur",
          "authentication": "none",
          "options": {}
        }
      },
      {
        "id": "b0b755ca-8848-454c-bde9-562c726a80bf",
        "name": "Build BTC Rate Pairs",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          840,
          900
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const data = $input.first().json;\nconst price = data.bitcoin.eur;\nconst date = $today.toISODate();\nreturn [\n  { json: { date, from: 'BTC', to: 'EUR', rate: price } },\n  { json: { date, from: 'EUR', to: 'BTC', rate: 1 / price } }\n];"
        }
      },
      {
        "id": "b5d72c35-b227-4128-8516-56309c0fe374",
        "name": "Merge Rates",
        "type": "n8n-nodes-base.merge",

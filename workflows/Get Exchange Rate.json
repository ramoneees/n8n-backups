        "id": "35edcb03-d5df-46d4-844d-517b8d2c9ddc",
        "name": "Get EUR Rates",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.4,
        "position": [
          544,
          608
        ],
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 2000
      },
      {
        "parameters": {
          "jsCode": "const data = $input.first().json;\nconst date = data.date;\nconst rates = data.rates;\nconst pairs = [];\nfor (const code of Object.keys(rates)) {\n  const rate = rates[code];\n  pairs.push({ json: { date, from: 'EUR', to: code, rate } });\n  pairs.push({ json: { date, from: code, to: 'EUR', rate: 1 / rate } });\n}\nreturn pairs;"
        },
        "id": "7491031f-8ead-4349-9bb5-31df0a4c3515",
        "name": "Build Rate Pairs",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          848,
          608
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://firefly-iii.apps.svc.cluster.local:8080/api/v1/exchange-rates",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpBearerAuth",
          "sendBody": true,
          "bodyParameters": {

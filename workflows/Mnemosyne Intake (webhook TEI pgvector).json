      "position": [
        448,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://tei.olympus.svc.cluster.local:80/embed",
        "sendBody": true,
        "specifyBody": "json",
        "contentType": "json",
        "jsonBody": "={{ JSON.stringify({ inputs: $json.content.substring(0, 6000) }) }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "16eba0a4-e8bf-42da-9c82-0b4cbcedfaea",
      "name": "Merge Embedding",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "jsCode": "const emb = Array.isArray($json) ? $json[0] : $json;\nconst src = $('Parse and Auth').item.json;\nreturn [{ json: Object.assign({}, src, { embedding: JSON.stringify(emb) }) }];\n"
      }
    },
    {
      "id": "7653d23f-055a-413e-8104-72c8524c72e6",
      "name": "Upsert pgvector",

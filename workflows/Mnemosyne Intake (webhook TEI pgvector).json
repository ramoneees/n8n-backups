      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "jsCode": "const secret = $json.headers && $json.headers['x-mnemo-secret'];\nif (secret !== 'n8n-webhook-secret-2024') { throw new Error('unauthorized'); }\nconst p = $json.body;\nif (!p || !Array.isArray(p.entries) || p.entries.length === 0) { throw new Error('payload invalido'); }\nreturn p.entries.map(e => ({ json: {\n  namespace: p.namespace || '/memory/faturas',\n  source_agent: p.source_agent || 'n8n-intake',\n  key: e.key || (e.metadata && e.metadata.file_path) || ('entry-' + Date.now() + '-' + Math.random().toString(36).slice(2,8)),\n  content: e.content,\n  metadata: e.metadata || {}\n}}));\n"
      }
    },
    {
      "id": "2df5d39e-488e-470a-a724-d6c89f00debc",
      "name": "Embed via TEI",
      "type": "n8n-nodes-base.httpRequest",

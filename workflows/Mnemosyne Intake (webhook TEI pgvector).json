      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH del AS (DELETE FROM memory_entries WHERE namespace = $1 AND metadata->>'key' = $2) INSERT INTO memory_entries (content, metadata, namespace, embedding, source_agent) VALUES ($4, $5::jsonb, $1, $3::vector, $6)",
        "options": {
          "queryReplacement": "={{ JSON.stringify([$json.namespace, $json.key, $json.embedding, $json.content, JSON.stringify($json.metadata), $json.source_agent]) }}"
        }

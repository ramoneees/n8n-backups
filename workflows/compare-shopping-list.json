      "parameters": {
        "command": "=cd {{ $env.GROCERY_PROJECT_DIR }} && timeout 60 python3 scripts/match_products.py \"tmp/list_{{ $('Classify List Format').item.json.correlation_id }}.json\" hybrid"
      },
      "notes": "exitCode 0=success 1=script error 2=timeout",
      "retryOnFail": true,

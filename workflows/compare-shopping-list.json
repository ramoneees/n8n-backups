      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const result = $input.first().json;\nlet basket = { pending: [], error: null };\nif (result.basket_optimize_failed) {\n  basket = { pending: [], error: result.error };\n} else if (result.stdout) {\n  try { basket = JSON.parse(result.stdout); } catch (e) { basket = { pending: [], error: 'invalid optimize_basket.py output' }; }\n}\nreturn [{ json: basket }];"
      }
    },

    {
      "id": "2581194a-d892-478b-a424-aa2a53d8666d",
      "name": "Classify List Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const ctx = $input.first().json;\nconst lines = (ctx.raw_text || '').split('\\n').map(l => l.trim()).filter(Boolean);\nconst structuredLine = /^(\\d+)\\s*[xX]?\\s*([\\w./-]+)$/;\nconst parsedLines = lines.map(l => l.match(structuredLine));\nconst isStructured = lines.length > 0 && parsedLines.every(m => m !== null);\nlet items = [];\nif (isStructured) {\n  items = parsedLines.map(m => {\n    const token = m[2];\n    const isEan = /^\\d{8,13}$/.test(token);\n    return { query: token, quantity: parseInt(m[1], 10) || 1, unit: 'un', brand_hint: null, ean: isEan ? token : null };\n  });\n}\nreturn [{ json: { correlation_id: ctx.correlation_id, chat_id: ctx.chat_id, raw_text: ctx.raw_text, is_structured: isStructured, items } }];"
      },
      "notes": "Structured lines (QTY x EAN / QTY description, single token after quantity) skip the LLM entirely. Anything else is treated as free text."
    },
    {
      "id": "d60a43e4-7bc3-4b96-b87f-94adff87443d",

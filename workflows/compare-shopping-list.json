      "parameters": {
        "command": "=cd {{ $env.GROCERY_PROJECT_DIR }} && timeout 60 python3 scripts/optimize_basket.py \"tmp/matches_{{ $('Classify List Format').item.json.correlation_id }}.json\" --postal-code \"{{ $env.GROCERY_POSTAL_CODE }}\" --max-stores 2 --loyalty-cards \"{{ $env.GROCERY_LOYALTY_CARDS }}\""

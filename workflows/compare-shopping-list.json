    {
      "id": "ea91dadc-6879-4984-93f8-c81a2cd93e51",
      "name": "Ambiguity Decisions Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        3640,
        500
      ],
      "parameters": {

      "onError": "continueErrorOutput"
    },
    {
      "id": "4d7ae24d-eae4-44a2-992e-617cb9beec70",
      "name": "Split Resolved And Ambiguous",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const result = $input.first().json;\nlet matches = result.matches || [];\nif (result.match_script_failed) {\n  matches = [];\n}\nif (!result.match_script_failed && result.exitCode !== undefined && result.exitCode !== 0) {\n  matches = [];\n}\nif (!result.matches && result.stdout) {\n  try { matches = JSON.parse(result.stdout).matches || []; } catch (e) { matches = []; }\n}\nconst resolved = matches.filter(m => (m.confidence || 0) >= 0.85 && !m.needs_llm);\nconst ambiguous = matches.filter(m => m.needs_llm || (m.confidence || 0) < 0.85);\nreturn [{ json: { resolved, ambiguous, hasAmbiguous: ambiguous.length > 0 } }];"
      },
      "notes": "A single unmatched item never aborts the run - it just gets carried through as pending."
    },

        "language": "javaScript",
        "jsCode": "console.log('optimize_basket.py failed: ' + ($json.stderr || 'unknown error'));\nreturn [{ json: { basket_optimize_failed: true, error: $json.stderr || 'unknown error' } }];"
      },
      "notes": "Even if optimize_basket.py fails, the user still gets a report instead of silence."

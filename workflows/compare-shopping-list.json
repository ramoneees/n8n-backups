      }
    },
    {
      "id": "951b8d57-8109-48d2-a746-d17379026b0d",
      "name": "Merge Ambiguity Decisions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3640,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const split = $('Split Resolved And Ambiguous').item.json;\nconst decisions = $input.first().json.output || {};\nconst decided = split.ambiguous.map(m => {\n  const chosenId = decisions[m.query];\n  const chosen = (m.candidates || []).find(c => c.product_id === chosenId) || null;\n  return Object.assign({}, m, { chosen, resolved_by: chosen ? 'llm' : 'unresolved' });\n});\nconst allMatches = split.resolved.concat(decided);\nreturn [{ json: { matches: allMatches } }];"
      }
    },
    {
      "id": "cc7898a9-def7-41eb-948d-7613f79a4a82",
      "name": "Persist Match Decisions",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        3900,
        300
      ],
      "parameters": {
        "command": "=cd {{ $env.GROCERY_PROJECT_DIR }} && sqlite3 \"$GROCERY_DB\" \"INSERT INTO match_decisions (query, chosen_product_id, resolved_by, decided_at) SELECT json_extract(value,'$.query'), json_extract(value,'$.chosen.product_id'), 'llm', datetime('now') FROM json_each('{{ JSON.stringify($json.matches.filter(m => m.resolved_by === \\'llm\\')) }}');\""
      },
      "notes": "Best-effort learning log; does not block the run if it fails. exitCode 0=success 1=sqlite error.",
      "onError": "continueRegularOutput"
    },
    {
      "id": "2774c7e4-d43e-4d0f-aff7-a85ce1a347a9",
      "name": "Shape Matches File Content",
      "type": "n8n-nodes-base.code",
